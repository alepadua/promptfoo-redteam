# Variáveis de Ambiente — Copilot Security Eval

# =============================================================
# JUIZ DE IA (avaliador de respostas) — escolha UMA opção
# =============================================================

# Opção A: Google Gemini (RECOMENDADO — gratuito)
# Obter em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Opção B: OpenAI
# Obter em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================
# PROMPTFOO CLOUD (necessário para indirect-prompt-injection)
# =============================================================
# Criar conta em: https://promptfoo.app
# Autenticar com: promptfoo auth login
PROMPTFOO_API_KEY=

# =============================================================
# CONFIGURAÇÕES DO CHROME (opcional)
# =============================================================
CHROME_PORT=9222
COPILOT_URL=https://copilot.microsoft.com
