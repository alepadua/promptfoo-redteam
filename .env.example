# Variáveis de Ambiente — GenAI Security Eval

# =============================================================
# 1. PRIVACIDADE TOTAL — DESABILITAR CLOUD SHARING & TELEMETRIA
# =============================================================
# Desabilita o envio de relatórios e telemetria para a nuvem da Promptfoo
PROMPTFOO_DISABLE_SHARING=true
PROMPTFOO_DISABLE_TELEMETRY=true

# Desabilita chamadas remotas de geração (executa 100% offline local)
PROMPTFOO_DISABLE_REMOTE_GENERATION=true
PROMPTFOO_DISABLE_REDTEAM_REMOTE_GENERATION=true

# =============================================================
# 2. AMAZON BEDROCK — GERAÇÃO DE TESTES E AVALIAÇÃO (RECOMENDADO)
# =============================================================
# Região onde o Bedrock está habilitado (ex: us-east-1, us-west-2, sa-east-1)
AWS_REGION=us-east-1

# Credenciais IAM da AWS (chaves de acesso):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Se utilizar credenciais temporárias / SSO / STS:
# AWS_SESSION_TOKEN=

# Se já possui perfil configurado no terminal (~/.aws/credentials):
# AWS_PROFILE=default

# Modelo padrão do Bedrock sugerido:
# bedrock:anthropic.claude-3-5-sonnet-20241022-v2:0
# bedrock:us.anthropic.claude-3-5-sonnet-20241022-v2:0 (Cross-region)
# bedrock:anthropic.claude-3-haiku-20240307-v1:0 (Mais rápido / econômico)

# =============================================================
# 3. OUTROS PROVIDERS DE IA (Opcional se não usar Bedrock)
# =============================================================

# Opção A: Google Gemini
# Obter em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Opção B: OpenAI
# Obter em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================
# 4. CONFIGURAÇÕES DO CHROME / NAVEGADOR
# =============================================================
CHROME_PORT=9222
COPILOT_URL=https://copilot.microsoft.com
