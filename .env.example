# Variáveis de Ambiente — GenAI Security Eval

# =============================================================
# 1. PRIVACIDADE TOTAL — DESABILITAR CLOUD SHARING & TELEMETRIA
# =============================================================
# Desabilita o envio de relatórios e telemetria para a nuvem da Promptfoo
PROMPTFOO_DISABLE_SHARING=true
PROMPTFOO_DISABLE_TELEMETRY=true

# Desabilita chamadas remotas de geração (executa 100% offline local)
PROMPTFOO_DISABLE_REMOTE_GENERATION=true
PROMPTFOO_DISABLE_REDTEAM_REMOTE_GENERATION=true

# =============================================================
# 2. AMAZON BEDROCK MANTLE — API DIRECT (BEARER TOKEN / SEM IAM)
# =============================================================
# Utiliza a API compatível OpenAI do Bedrock Mantle (chat/completions)
# Autenticação direta por Token — NÃO exige credenciais de conta IAM da AWS.
AWS_BEARER_TOKEN_BEDROCK=

# Região onde o Bedrock Mantle está ativo (ex: us-east-1, us-west-2, etc.)
AWS_REGION=us-east-1

# Modelos recomendados disponíveis no Mantle:
# bedrock:mantle:deepseek.v3.1
# bedrock:mantle:mistral.mistral-large-2407-v1:0
# bedrock:mantle:qwen.qwen2-5-72b-instruct
# bedrock:mantle:zai.glm-4.6

# =============================================================
# 3. AMAZON BEDROCK RUNTIME (OPCIONAL: caso use credenciais IAM)
# =============================================================
# Apenas se optar pelo Bedrock Runtime clássico com credenciais AWS:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=default

# =============================================================
# 3. OUTROS PROVIDERS DE IA (Opcional se não usar Bedrock)
# =============================================================

# Opção A: Google Gemini
# Obter em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Opção B: OpenAI
# Obter em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================
# 4. CONFIGURAÇÕES DO CHROME / NAVEGADOR
# =============================================================
CHROME_PORT=9222
COPILOT_URL=https://copilot.microsoft.com
